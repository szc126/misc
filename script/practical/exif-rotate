#!/usr/bin/env bash

case "$1" in
"0" | "none")
	exif --ifd=0 --tag=0x0112 --set-value=1 --no-fixup "$2" --output="$2.rotated.jpg";
	;;
"90" | "cw" | "right")
	exif --ifd=0 --tag=0x0112 --set-value=6 --no-fixup "$2" --output="$2.rotated.jpg";
	;;
"180")
	exif --ifd=0 --tag=0x0112 --set-value=3 --no-fixup "$2" --output="$2.rotated.jpg";
	;;
"270" | "ccw" | "left")
	exif --ifd=0 --tag=0x0112 --set-value=8 --no-fixup "$2" --output="$2.rotated.jpg";
	;;
*)
	echo "$1 is not an option :(";
	;;
esac